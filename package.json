{
  "name": "enterprise-pdf-editor",
  "version": "0.1.0",
  "private": true,
  "description": "Framework-agnostic PDF editor SDK",
  "workspaces": [
    "packages/*",
    "examples/vanilla"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present && npm run sync:aspnet-sdk",
    "check": "npm run check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:structural": "npm run build --workspace @enterprise-pdf-editor/engine-structural && node scripts/verify-structural.mjs",
    "sync:aspnet-sdk": "node scripts/sync-aspnet-sdk.mjs",
    "test:liteparse": "node scripts/verify-liteparse.mjs",
    "licenses:check": "node scripts/check-licenses.mjs"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vite": "^7.1.7"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1"
  },
  "license": "MIT"
}
